# String de conexão com o banco de dados MySQL
# Se usar o Docker Compose incluso, as credenciais abaixo já funcionarão:
DATABASE_URL="mysql://root:petscedim2025!@localhost:3307/anamneses_db"

# Segredo para autenticação. Gere o seu:  openssl rand -base64 48
# Em produção a aplicação RECUSA subir com este valor de exemplo.
JWT_SECRET="TROQUE_ESTE_VALOR"

# Senha root do MySQL no Docker
MYSQL_ROOT_PASSWORD="petscedim2025!"

# Usuário administrador criado pelo seed. Em produção os dois são OBRIGATÓRIOS: sem eles, ou com a
# senha igual à publicada no README, o seed recusa e a aplicação não sobe.
SEED_EMAIL="admin@exemplo.local"
SEED_PASSWORD="TROQUE_ESTA_SENHA"
